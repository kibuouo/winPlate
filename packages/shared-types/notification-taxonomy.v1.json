{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://winplate.local/taxonomies/notification.v1.json",
  "title": "WinPlate notification taxonomy",
  "schemaVersion": 1,
  "unknownSource": "external",
  "canonicalSources": [
    "qweather",
    "codex",
    "chatgpt",
    "github",
    "mail",
    "system",
    "external"
  ],
  "sourceAliases": {
