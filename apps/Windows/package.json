{
  "name": "@winplate/windows-electron",
  "productName": "WinPlate",
  "version": "0.3.0",
  "private": true,
  "description": "The Windows-native WinPlate status center built with Electron.",
  "author": "kibuouo",
  "repository": {
    "type": "git",
    "url": "https://github.com/kibuouo/winPlate.git"
  },
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "cross-env FORCE_COLOR=1 electron .",
    "electron": "electron .",
    "dist": "electron-builder --win nsis --x64 --publish never",
    "precheck": "npm run check:syntax",
    "check": "npm run test:unit",
    "check:syntax": "node ../../scripts/checkJavaScriptSyntax.js src",
    "test": "npm run test:unit",
    "test:unit": "node --test"
  },
  "build": {
    "appId": "com.kiko.winplate",
    "asar": true,
    "artifactName": "WinPlate-Setup-${version}.${ext}",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "!src/**/*.test.js",
      "assets/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": ".build/backend",
        "to": "backend/bin",
        "filter": [
          "winplate-backend.exe"
        ]
      }
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "include": "build/installer.nsh",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "WinPlate",
      "deleteAppDataOnUninstall": false
    }
  },
  "dependencies": {
    "@winplate/core": "0.3.0",
    "@winplate/icons": "0.3.0",
    "strip-ansi": "^6.0.1"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "electron": "41.10.3",
    "electron-builder": "^26.15.3",
    "jsdom": "^26.1.0"
  }
}
